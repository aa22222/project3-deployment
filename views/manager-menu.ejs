<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Boba Shop POS - Menu Management</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="manager-main">
        <nav class="manager-tabs" aria-label="Manager sections">
            <a class="manager-tab" href="/">Portal Hub</a>
            <a class="manager-tab" href="/manager">Inventory</a>
            <a class="manager-tab" href="/manager/menu" aria-current="page">Menu</a>
            <a class="manager-tab" href="/manager/payroll">Payroll</a>
            <a class="manager-tab" href="/manager/x-report">X-report</a>
        </nav>
        <section class="manager-overview" aria-label="Menu overview">
            <div class="manager-overview-copy">
                <h2>Edit menu</h2>
                <p>Update item names, prices, and seasonal status, then save each item.</p>
            </div>
            <p class="inventory-summary"><strong><%= menuItems.length %></strong> menu items</p>
        </section>
        <section class="panel manager-panel">
            <p>Saved changes appear when the ordering menu is next loaded.</p>
            <form action="/manager/menu" class="inventory-toolbar">
                <label class="menu-search" for="manager-menu-search">Find a menu item
                    <input id="manager-menu-search" type="search" placeholder="Search by name..." autocomplete="off" aria-controls="manager-menu-list">
                </label>
                <button type="submit">Refresh menu</button>
            </form>
            <p id="manager-menu-message" role="status"><%= error || (menuItems.length ? '' : 'No menu items found.') %></p>
            <div id="manager-menu-list">
                <% menuItems.forEach(item => { %>
                <form class="menu-edit-row" data-id="<%= item.menu_item_id %>">
                    <label for="menu-name-<%= item.menu_item_id %>">Item name
                        <input id="menu-name-<%= item.menu_item_id %>" name="name" type="text" value="<%= item.item_name %>" maxlength="200" required>
                    </label>
                    <label for="menu-price-<%= item.menu_item_id %>">Price ($)
                        <input id="menu-price-<%= item.menu_item_id %>" name="price" type="number" min="0" max="999999.99" step="0.01" value="<%= Number(item.current_price).toFixed(2) %>" required>
                    </label>
                    <label class="menu-seasonal" for="menu-seasonal-<%= item.menu_item_id %>">
                        <input id="menu-seasonal-<%= item.menu_item_id %>" name="isSeasonal" type="checkbox" <%= item.is_seasonal ? 'checked' : '' %>>
                        Seasonal item
                    </label>
                    <button type="submit">Save</button>
                    <button type="reset" class="menu-reset">Reset</button>
                    <span class="menu-edit-feedback" role="status"></span>
                </form>
                <% }); %>
            </div>
        </section>
    </main>
    <script src="/manager-menu.js" defer></script>
</body>
</html>
