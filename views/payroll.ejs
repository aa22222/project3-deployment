<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Boba Shop POS - Payroll</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div><h1>Boba Shop POS</h1><p class="subtitle">Manager - Payroll</p></div>
        <a class="manager-back-link" href="/manager">Back to Manager</a>
    </header>
    <main class="manager-main">
        <nav class="manager-tabs" aria-label="Manager sections">
            <a class="manager-tab" href="/manager">Inventory</a>
            <a class="manager-tab" href="/manager/payroll" aria-current="page">Payroll</a>
        </nav>
        <section class="panel manager-panel">
            <div class="manager-panel-heading">
                <h2>Payroll details</h2>
                <span class="payroll-count"><%= employees.length %> <%= employees.length === 1 ? 'employee' : 'employees' %></span>
            </div>
            <p>Employee and compensation information from your staff records.</p>
            <% if (error) { %><p class="payroll-message payroll-error" role="alert"><%= error %></p>
            <% } else if (!employees.length || !columns.length) { %><p class="payroll-empty" role="status">No employee records yet. Add employee records to the employee table to see payroll here.</p>
            <% } else { %>
            <div class="payroll-table-wrap">
                <table class="payroll-table">
                    <thead><tr><% columns.forEach(column => { %><th scope="col"><%= column.replace(/_/g, ' ') %></th><% }); %></tr></thead>
                    <tbody><% employees.forEach(employee => { %><tr><% columns.forEach(column => { %><td><%= employee[column] == null ? '—' : employee[column] %></td><% }); %></tr><% }); %></tbody>
                </table>
            </div>
            <% } %>
        </section>
    </main>
</body>
</html>
