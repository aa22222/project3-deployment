<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Boba Shop POS — Kitchen</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="kitchen-page">
    <header class="kitchen-header">
        <div>
            <h1>Boba Shop POS</h1>
            <p class="subtitle">Kitchen orders</p>
        </div>
        <a class="hub-link" href="/">← Back to Hub</a>
    </header>
    <main class="kitchen-content">
        <div class="kitchen-heading">
            <h2>Orders</h2>
            <button class="kitchen-refresh" id="refresh-orders" type="button">Refresh</button>
        </div>
        <p class="kitchen-message" id="queue-message" role="status" aria-live="polite">Loading orders…</p>
        <section class="order-grid" id="order-grid" aria-label="Kitchen orders"></section>
    </main>
    <script>
        const orderGrid = document.getElementById('order-grid');
        const message = document.getElementById('queue-message');
        let orders = [];

        const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
        const money = value => '$' + Number(value || 0).toFixed(2);
        const timeLabel = value => new Intl.DateTimeFormat(undefined, {hour: 'numeric', minute: '2-digit'}).format(new Date(value));

        function renderOrders() {
            const visibleOrders = [...orders].sort((a, b) => new Date(a.orderTime) - new Date(b.orderTime));
            if (!visibleOrders.length) {
                orderGrid.innerHTML = '';
                message.hidden = false;
                message.textContent = 'No orders yet.';
                return;
            }
            message.hidden = true;
            orderGrid.innerHTML = visibleOrders.map(order => {
                const items = order.items.map(item => `
                    <li class="kitchen-order-item">
                        <span class="item-quantity">${Number(item.quantity)}×</span>
                        <span><strong>${escapeHtml(item.name)}</strong>${item.customizations ? `<small>${escapeHtml(item.customizations)}</small>` : ''}</span>
                    </li>`).join('');
                let actions = '';
                if (order.status === 'New') actions = `<button class="kitchen-action" data-status="Preparing" data-id="${order.orderId}" type="button">Start preparing</button><button class="kitchen-cancel" data-status="Cancelled" data-id="${order.orderId}" type="button">Cancel</button>`;
                if (order.status === 'Preparing') actions = `<button class="kitchen-action" data-status="Ready" data-id="${order.orderId}" type="button">Mark ready</button><button class="kitchen-cancel" data-status="Cancelled" data-id="${order.orderId}" type="button">Cancel</button>`;
                if (order.status === 'Ready') actions = `<button class="kitchen-action secondary" data-status="New" data-id="${order.orderId}" type="button">Reopen</button>`;
                if (order.status === 'Cancelled') actions = `<button class="kitchen-action secondary" data-status="New" data-id="${order.orderId}" type="button">Restore</button>`;
                return `<article class="panel kitchen-order-card">
                    <div class="kitchen-order-heading"><div><strong class="kitchen-order-number">Order #${order.orderId}</strong><span class="kitchen-order-time">${timeLabel(order.orderTime)}</span></div><span class="kitchen-status ${order.status.toLowerCase()}">${escapeHtml(order.status)}</span></div>
                    <ul class="kitchen-order-items">${items}</ul>
                    <div class="kitchen-order-total"><span>${order.items.reduce((sum, item) => sum + Number(item.quantity), 0)} drinks</span><strong>${money(order.total)}</strong></div>
                    <div class="kitchen-order-actions">${actions}</div>
                </article>`;
            }).join('');
        }

        async function loadOrders() {
            try {
                const response = await fetch('/api/kitchen/orders');
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || 'Could not load orders.');
                orders = result;
                renderOrders();
            } catch (error) {
                message.hidden = false;
                message.textContent = error.message;
            }
        }

        orderGrid.addEventListener('click', async event => {
            const button = event.target.closest('[data-status]');
            if (!button) return;
            if (button.dataset.status === 'Cancelled' && !window.confirm(`Cancel order #${button.dataset.id}?`)) return;
            button.disabled = true;
            try {
                const response = await fetch(`/api/kitchen/orders/${button.dataset.id}/status`, {
                    method: 'PATCH', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({status: button.dataset.status})
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || 'Could not update the order.');
                const order = orders.find(item => item.orderId === Number(button.dataset.id));
                if (order) order.status = result.status;
                renderOrders();
            } catch (error) {
                button.disabled = false;
                message.hidden = false;
                message.textContent = error.message;
            }
        });

        document.getElementById('refresh-orders').addEventListener('click', loadOrders);
        loadOrders();
        window.setInterval(loadOrders, 20000);
    </script>
</body>
</html>
