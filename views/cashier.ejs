<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Boba Shop POS — <%= pageTitle %></title>
    <link rel="stylesheet" href="/style.css">
    <% if (pageTitle === 'Customer Kiosk') { %>
    <script>try { if (localStorage.getItem('kiosk-high-contrast') === 'true') document.documentElement.dataset.highContrast = 'true'; } catch (_) {}</script>
    <% } %>
</head>
<% const isMobile = pageTitle === 'Mobile Ordering'; const isKiosk = pageTitle === 'Customer Kiosk'; const isCustomer = isKiosk || isMobile; const hasEditor = isCustomer || pageTitle === 'Cashier'; %>
<body class="order-page <%= isMobile ? 'kiosk-page mobile-page' : pageTitle === 'Cashier' ? 'cashier-page' : 'kiosk-page' %>">
    <a class="skip-link" href="#menu-heading">Skip to menu</a>
    <a class="skip-link" href="#order-heading">Skip to order</a>
    <% if (hasEditor) { %>
    <% if (!isKiosk) { %><div id="language-tools" class="language-tools" translate="no">
        <label for="page-language">Language / Idioma</label>
        <select id="page-language"><option value="en" lang="en">English</option><option value="es" lang="es">Español</option></select>
        <span id="language-status" role="status" aria-live="polite"></span>
    </div><% } %>
    <script src="/translate.js" defer></script>
    <% } %>
    <% if (isCustomer && kioskMenuCategories.length) { %>
    <nav class="kiosk-category-nav" aria-label="Menu categories">
        <% kioskMenuCategories.forEach((category, index) => { %><a href="#kiosk-category-<%= index %>" title="<%= category.name %>"><%= category.name.split(' / ')[0] %></a><% }); %>
        <% if (isKiosk) { %>
        <div id="language-tools" class="language-tools kiosk-language-tools" translate="no">
            <label for="page-language">Language / Idioma</label>
            <select id="page-language"><option value="en" lang="en">English</option><option value="es" lang="es">Español</option></select>
            <span id="language-status" role="status" aria-live="polite"></span>
        </div>
        <button class="contrast-toggle" id="contrast-toggle" type="button" aria-pressed="false">High contrast: Off</button>
        <% } %>
    </nav>
    <% } %>
    <% if (isMobile) { %><nav class="mobile-order-nav" aria-label="Ordering"><a href="#menu-heading">Browse menu</a><a href="#order-heading" id="mobile-cart-link">View order &middot; <span id="mobile-cart-count">0</span></a></nav><% } %>
    <main>
        <section class="panel menu-panel" aria-labelledby="menu-heading">
            <h2 tabindex="-1" id="menu-heading">Menu</h2>
            <% if (isCustomer) { %>
            <details class="weather-panel">
                <summary>College Station weather</summary>
                <div id="weather-data" aria-busy="true"><div id="weather-content"></div></div>
                <p id="weather-status" role="status" aria-live="polite">Loading weather…</p>
                <button id="weather-refresh" type="button">Refresh weather</button>
                <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Weather data by Open-Meteo</a>
            </details>
            <script src="/weather.js" defer></script>
            <%- include('partials/assistant') %>
            <% } %>
            <div id="menu">
                <% if (isCustomer) { %>
                    <% kioskMenuCategories.forEach((category, index) => { %>
                    <section class="kiosk-menu-category" id="kiosk-category-<%= index %>" aria-labelledby="category-<%= index %>">
                        <div class="kiosk-menu-category-heading">
                            <h3 id="category-<%= index %>"><%= category.name %></h3>
                            <p><%= category.description %></p>
                        </div>
                        <div class="kiosk-menu-category-items">
                        <% category.items.forEach(item => { %>
                        <button class="drink" type="button" data-id="<%= item.menu_item_id %>" data-name="<%= item.item_name %>" data-price="<%= item.current_price %>" data-customizations="<%= item.customizations.join('|') %>" aria-label="Add <%= item.item_name %> for $<%= Number(item.current_price).toFixed(2) %>">
                        <% if (item.imageUrl) { %>
                        <span class="kiosk-drink-art"><img class="menu-image" src="<%= item.imageUrl %>" alt="" loading="lazy" decoding="async"></span>
                        <% } else { %>
                        <span class="menu-image-placeholder kiosk-drink-art" aria-hidden="true"><svg viewBox="0 0 120 130" fill="none"><path d="m71 18 19-13" stroke="#61202d" stroke-width="5" stroke-linecap="round"/><path d="M31 27h63l-8 87H40l-9-87Z" fill="#fff9ec" stroke="#61202d" stroke-width="4"/><path d="M36 54h53l-5 53H42l-6-53Z" fill="#d79261"/><path d="M37 52h53" stroke="#61202d" stroke-width="4"/><circle cx="51" cy="96" r="5" fill="#61202d"/><circle cx="66" cy="101" r="5" fill="#61202d"/><circle cx="77" cy="91" r="5" fill="#61202d"/><path d="m48 37 3 10m29-10-3 10" stroke="#fff" stroke-width="4" stroke-linecap="round"/></svg></span>
                        <% } %>
                        <span class="drink-name"><%= item.item_name %></span>
                        <span class="price">$<%= Number(item.current_price).toFixed(2) %></span>
                        </button>
                        <% }); %>
                        </div>
                    </section>
                    <% }); %>
                <% } else { %>
                    <% menuItems.forEach(item => { %>
                        <button class="drink" type="button" data-id="<%= item.menu_item_id %>" data-name="<%= item.item_name %>" data-price="<%= item.current_price %>" data-customizations="<%= item.customizations.join('|') %>" aria-label="Add <%= item.item_name %> for $<%= Number(item.current_price).toFixed(2) %>">
                        <% if (isCustomer) { %>
                            <% if (item.imageUrl) { %>
                            <img class="menu-image" src="<%= item.imageUrl %>" alt="" loading="lazy" decoding="async">
                            <% } else { %>
                            <span class="menu-image-placeholder" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><path d="M22 17h26l-4 39H26l-4-39Zm-4 0h34M39 17l4-12"/><circle cx="32" cy="45" r="2"/><circle cx="40" cy="46" r="2"/><circle cx="35" cy="51" r="2"/></svg><span>Image coming soon</span></span>
                            <% } %>
                        <% } %>
                        <span class="drink-name"><%= item.item_name %></span>
                        <span class="price">$<%= Number(item.current_price).toFixed(2) %></span>
                        </button>
                    <% }); %>
                <% } %>
                <% if (menuItems.length === 0) { %><p>No menu items are available yet.</p><% } %>
            </div>
        </section>
        <aside class="panel" aria-labelledby="order-heading">
            <h2 tabindex="-1" id="order-heading" class="cart-title">Order <% if (hasEditor) { %><span id="order-count">0 items</span><% } else { %><span class="cart-hint">— tap × to remove</span><% } %></h2>
            <div id="cart" role="list" aria-label="Current order"></div>
            <p id="cart-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
            <div class="checkout">
                <%- include('partials/rewards') %>
                <% if (isMobile) { %><p class="mobile-payment-note">Payment is collected at pickup. Choose how you plan to pay.</p><% } %>
                <label class="payment-label" for="payment-method">Payment method</label>
                <select id="payment-method" name="paymentMethod" required>
                    <option value="" selected disabled>Choose a payment method</option>
                    <option value="Cash">Cash</option>
                    <option value="Card">Credit or debit card</option>
                    <option value="Mobile pay">Mobile pay</option>
                </select>
                <div class="total"><span>TOTAL</span><span id="total">$0.00</span></div>
                <button id="submit" type="button"><%= pageTitle === 'Customer Kiosk' || isMobile ? 'Place order' : 'Submit order' %></button>
                <p id="notice" role="status" aria-live="polite" aria-atomic="true"></p>
            </div>
        </aside>
    </main>
    <dialog id="receipt" aria-labelledby="receipt-title">
        <article class="receipt-paper">
            <h2 tabindex="-1" id="receipt-title">Boba Shop</h2>
            <p class="receipt-subtitle">Customer receipt</p>
            <div class="receipt-details">
                <div><span>Order</span><strong id="receipt-order-number" translate="no"></strong></div>
                <div><span>Date</span><strong id="receipt-date" translate="no"></strong></div>
                <div><span>Payment</span><strong id="receipt-payment"></strong></div>
            </div>
            <div id="receipt-items" class="receipt-items"></div>
            <p id="receipt-rewards" hidden></p>
            <div class="receipt-total"><span>Total</span><strong id="receipt-total"></strong></div>
            <p class="receipt-thanks">Thank you!</p>
            <div class="receipt-actions">
                <button id="print-receipt" type="button">Print receipt</button>
                <button id="new-order" type="button">New order</button>
            </div>
        </article>
    </dialog>
    <% if (hasEditor) { %>
    <dialog id="drink-editor" aria-labelledby="editor-title" aria-describedby="editor-hint">
        <form id="drink-form">
            <h2 id="editor-title">Customize item</h2>
            <p id="editor-hint">Choose options for this order line. To order different options, add the item again.</p>
            <label class="quantity-label" for="drink-quantity">Quantity</label>
            <input id="drink-quantity" name="quantity" type="number" min="1" max="1000" step="1" value="1" required autofocus>
            <fieldset id="topping-options">
                <legend>Toppings</legend>
                <label class="drink-option"><input id="drink-boba" name="boba" type="checkbox"> Add boba (+$0.99 per drink)</label>
            </fieldset>
            <fieldset id="ice-options">
                <legend>Ice level</legend>
                <label class="drink-option"><input type="radio" name="ice" value="" checked> Regular ice</label>
                <label class="drink-option"><input type="radio" name="ice" value="Less ice"> Less ice</label>
                <label class="drink-option"><input type="radio" name="ice" value="More ice"> More ice</label>
            </fieldset>
            <fieldset id="sweetness-options">
                <legend>Sweetness</legend>
                <label class="drink-option"><input type="radio" name="sweetness" value="" checked> Regular sweetness</label>
                <label class="drink-option"><input type="radio" name="sweetness" value="Less sweet"> Less sweet</label>
            </fieldset>
            <p id="editor-no-customizations" hidden>This item has no available customizations.</p>
            <p class="editor-total">Item total <output id="item-total" data-testid="item-total" aria-live="polite">$0.00</output></p>
            <p id="editor-error" role="alert"></p>
            <div class="editor-actions">
                <button id="save-drink" type="submit">Add to order</button>
                <button id="cancel-drink" type="button">Cancel</button>
            </div>
        </form>
    </dialog>
    <% } %>
    <script src="/rewards.js"></script>
    <script>
        const cart = [];
        let placingOrder = false;
        let checkoutAttempt;
        const paymentMethod = document.getElementById('payment-method');
        const notice = document.getElementById('notice');
        const money = value => '$' + value.toFixed(2);
        const escapeHtml = value => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
        const linePrice = line => line.price + (line.customizations.includes('Boba') ? 0.99 : 0);
        const sameCustomizations = (a, b) => a.length === b.length && a.every(value => b.includes(value));
        paymentMethod.addEventListener('change', () => {
            paymentMethod.removeAttribute('aria-invalid');
            paymentMethod.removeAttribute('aria-describedby');
            if (notice.textContent === 'Choose a payment method to continue.') showNotice('');
        });
        const announceCartStatus = message => {
            const announcer = document.getElementById('cart-status');
            if (!announcer) return;
            announcer.textContent = '';
            window.requestAnimationFrame(() => {
                announcer.textContent = message;
            });
        };
        const categoryNav = document.querySelector('.kiosk-category-nav');
        const contrastToggle = document.getElementById('contrast-toggle');
        if (contrastToggle) {
            const contrastEnabled = document.documentElement.dataset.highContrast === 'true';
            contrastToggle.setAttribute('aria-pressed', String(contrastEnabled));
            contrastToggle.textContent = `High contrast: ${contrastEnabled ? 'On' : 'Off'}`;
            contrastToggle.addEventListener('click', () => {
                const enabled = contrastToggle.getAttribute('aria-pressed') !== 'true';
                document.documentElement.dataset.highContrast = String(enabled);
                contrastToggle.setAttribute('aria-pressed', String(enabled));
                contrastToggle.textContent = `High contrast: ${enabled ? 'On' : 'Off'}`;
                try { localStorage.setItem('kiosk-high-contrast', String(enabled)); } catch (_) {}
            });
        }
        if (categoryNav) {
            const updateNavHeight = () => document.body.style.setProperty('--category-nav-height', `${categoryNav.getBoundingClientRect().height}px`);
            new ResizeObserver(updateNavHeight).observe(categoryNav);
            updateNavHeight();
        }

        const editor = document.getElementById('drink-editor');
        const form = document.getElementById('drink-form');
        let selectedDrink, editingIndex, editorTrigger;

        function openEditor(drink, index, trigger) {
            selectedDrink = drink;
            editingIndex = index;
            editorTrigger = trigger;
            form.reset();
            form.elements.quantity.value = drink.quantity;
            form.elements.boba.checked = drink.customizations.includes('Boba');
            form.elements.ice.value = drink.customizations.find(value => value.endsWith('ice')) || '';
            form.elements.sweetness.value = drink.customizations.includes('Less sweet') ? 'Less sweet' : '';
            const available = new Set(drink.customizationOptions);
            document.getElementById('topping-options').hidden = !available.has('Boba');
            document.getElementById('ice-options').hidden = !available.has('Less ice') && !available.has('More ice');
            document.getElementById('sweetness-options').hidden = !available.has('Less sweet');
            document.getElementById('editor-no-customizations').hidden = available.size > 0;
            document.getElementById('editor-title').textContent = `Customize ${drink.name}`;
            document.getElementById('save-drink').textContent = index === null ? 'Add to order' : 'Save changes';
            document.getElementById('editor-error').textContent = '';
            updateItemTotal();
            editor.showModal();
        }

        function editorChoices() {
            return [form.elements.boba.checked ? 'Boba' : '', form.elements.ice.value, form.elements.sweetness.value]
                .filter(value => value && selectedDrink.customizationOptions.includes(value));
        }

        function updateItemTotal() {
            document.getElementById('item-total').textContent = form.elements.quantity.validity.valid
                ? money(linePrice({...selectedDrink, customizations: editorChoices()}) * Number(form.elements.quantity.value))
                : 'Enter a quantity from 1 to 1000';
        }

        if (editor) {
            form.addEventListener('input', updateItemTotal);
            document.getElementById('cancel-drink').onclick = () => editor.close();
            editor.addEventListener('keydown', event => {
                const first = form.elements.quantity, last = document.getElementById('cancel-drink');
                if (event.key === 'Tab' && (event.shiftKey ? document.activeElement === first : document.activeElement === last)) {
                    event.preventDefault();
                    (event.shiftKey ? last : first).focus();
                }
            });
            editor.addEventListener('close', () => {
                (editorTrigger.isConnected ? editorTrigger : document.querySelector(`[data-action="edit"][data-index="${editingIndex}"]`))?.focus();
            });
            form.addEventListener('submit', event => {
                event.preventDefault();
                const line = {...selectedDrink, quantity: Number(form.elements.quantity.value), customizations: editorChoices()};
                const match = cart.find(item => item !== cart[editingIndex] && item.menuItemId === line.menuItemId && sameCustomizations(item.customizations, line.customizations));
                if (match && match.quantity + line.quantity > 1000) {
                    document.getElementById('editor-error').textContent = 'Matching drinks cannot exceed 1000 per order line.';
                    return;
                }
                const announcement = editingIndex === null ? `Added ${line.name}.` : `Updated ${line.name}.`;
                if (editingIndex !== null) cart.splice(editingIndex, 1);
                if (match) match.quantity += line.quantity;
                else cart.push(line);
                if (editingIndex !== null) editingIndex = cart.indexOf(match || line);
                renderCart(announcement);
                showNotice('');
                editor.close();
            });
        }

        document.querySelectorAll('.drink').forEach(button => button.addEventListener('click', () => {
            const id = Number(button.dataset.id);
            const customizationOptions = button.dataset.customizations ? button.dataset.customizations.split('|') : [];
            if (editor) return openEditor({menuItemId: id, name: button.dataset.name, price: Number(button.dataset.price), quantity: 1, customizations: [], customizationOptions}, null, button);
            const line = cart.find(item => item.menuItemId === id && item.customizations.length === 0);
            if (line) line.quantity++;
            else cart.push({menuItemId: id, name: button.dataset.name, price: Number(button.dataset.price), quantity: 1, customizations: [], customizationOptions});
            renderCart(`Added ${button.dataset.name}.`);
        }));

        function renderCart(announcement) {
            const cartElement = document.getElementById('cart');
            const itemCount = cart.reduce((sum, line) => sum + line.quantity, 0);
            const total = cart.reduce((sum, line) => sum + linePrice(line) * line.quantity, 0);
            if (cart.length === 0) {
                cartElement.innerHTML = '<p class="empty">Your order is empty.<br>Choose a menu item to get started.</p>';
            } else {
                cartElement.innerHTML = cart.map((line, index) => `
                    <div class="cart-line" role="listitem" aria-label="${escapeHtml(line.name)}, quantity ${line.quantity}, total ${money(linePrice(line) * line.quantity)}${line.customizations.length ? ', customizations: ' + escapeHtml(line.customizations.join(', ')) : ', no customizations'}">
                        <div>
                            <div class="line-name">${escapeHtml(line.name)}</div>
                            <div class="line-meta">${line.quantity} × ${money(linePrice(line))} &nbsp; ${money(linePrice(line) * line.quantity)}</div>
                            ${line.customizations.length ? `<div class="line-custom">${escapeHtml(line.customizations.join(', '))}</div>` : ''}
                            <div class="line-actions">
                                <button class="qty-btn" type="button" data-action="decrease" data-index="${index}" aria-label="Remove one ${escapeHtml(line.name)}">−</button>
                                <span aria-label="Quantity ${line.quantity}">${line.quantity}</span>
                                <button class="qty-btn" type="button" data-action="increase" data-index="${index}" aria-label="Add one ${escapeHtml(line.name)}">+</button>
                                ${editor ? `<button class="edit-drink" type="button" data-action="edit" data-index="${index}" aria-label="Edit ${escapeHtml(line.name)}">Edit</button>` : ''}
                            </div>
                        </div>
                        <button class="remove" type="button" data-action="remove" data-index="${index}" aria-label="Remove ${escapeHtml(line.name)}">×</button>
                    </div>`).join('');
            }
            window.rewardsWidget.updateSubtotal(Math.round(total * 100));
            const orderCount = document.getElementById('order-count');
            if (orderCount) {
                orderCount.textContent = `${itemCount} item${itemCount === 1 ? '' : 's'}`;
            }
            const mobileCount = document.getElementById('mobile-cart-count');
            if (mobileCount) mobileCount.textContent = itemCount;
            document.getElementById('submit').disabled = cart.length === 0;
            if (announcement) {
                const summary = cart.length
                    ? `Your order has ${itemCount} item${itemCount === 1 ? '' : 's'} for a total of ${money(total)}.`
                    : 'Your order is empty.';
                announceCartStatus(`${announcement} ${summary}`);
            }
        }

        document.getElementById('cart').addEventListener('click', event => {
            const button = event.target.closest('[data-action]');
            if (!button) return;
            const index = Number(button.dataset.index);
            if (button.dataset.action === 'edit') return openEditor(cart[index], index, button);
            const line = cart[index];
            let announcement;
            if (button.dataset.action === 'remove') {
                cart.splice(index, 1);
                announcement = `Removed ${line.name}.`;
            }
            if (button.dataset.action === 'increase') {
                if (line.quantity >= 1000) return showNotice('An item quantity cannot exceed 1000 per order line.');
                cart[index].quantity++;
                announcement = `Added one ${line.name}.`;
            }
            if (button.dataset.action === 'decrease') {
                line.quantity--;
                if (line.quantity === 0) {
                    cart.splice(index, 1);
                    announcement = `Removed ${line.name}.`;
                } else {
                    announcement = `Removed one ${line.name}.`;
                }
            }
            const action = button.dataset.action;
            renderCart(announcement);
            const nextIndex = Math.min(index, cart.length - 1);
            (document.querySelector(`[data-action="${action}"][data-index="${nextIndex}"]`) || document.querySelector('.drink'))?.focus();
        });


        function showNotice(message) { notice.textContent = message; }
        window.addEventListener('rewards-change', () => {
            const subtotal = Math.round(cart.reduce((sum, line) => sum + linePrice(line) * line.quantity, 0) * 100);
            const discount = window.rewardsWidget.discountCents;
            document.getElementById('total').textContent = money((subtotal - discount) / 100);
        });

        document.getElementById('submit').addEventListener('click', async () => {
            if (placingOrder) return;
            if (cart.length === 0) return showNotice('Tap an item to add it to the order.');
            if (!paymentMethod.value) {
                paymentMethod.setAttribute('aria-invalid', 'true');
                paymentMethod.setAttribute('aria-describedby', 'notice');
                showNotice('Choose a payment method to continue.');
                paymentMethod.focus();
                return;
            }
            paymentMethod.removeAttribute('aria-invalid');
            paymentMethod.removeAttribute('aria-describedby');
            const submitButton = document.getElementById('submit');
            placingOrder = true;
            document.querySelector('main').inert = true;
            submitButton.disabled = true;
            showNotice('Submitting order…');
            try {
                const body = JSON.stringify({paymentMethod: paymentMethod.value, ...window.rewardsWidget.checkout, items: cart.map(({menuItemId, quantity, customizations}) => ({menuItemId, quantity, customizations}))});
                if (!checkoutAttempt) checkoutAttempt = { body, key: globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}` };
                const response = await fetch('/orders', {
                    method: 'POST', headers: {'Content-Type': 'application/json', 'Idempotency-Key': checkoutAttempt.key}, body: checkoutAttempt.body
                });
                const result = await response.json();
                if (!response.ok) {
                    checkoutAttempt = null;
                    if (response.status === 401) window.rewardsWidget.reset();
                    throw new Error(result.error || 'Could not submit the order.');
                }
                if (document.getElementById('receipt')) {
                    const receiptLines = cart.map(line => ({...line, customizations: [...line.customizations]}));
                    document.getElementById('receipt-order-number').textContent = `#${result.orderId}`;
                    document.getElementById('receipt-date').textContent = new Intl.DateTimeFormat(undefined, {dateStyle: 'medium', timeStyle: 'short'}).format(new Date());
                    document.getElementById('receipt-payment').textContent = result.paymentMethod;
                    document.getElementById('receipt-total').textContent = money(Number(result.total));
                    const rewardReceipt = document.getElementById('receipt-rewards');
                    rewardReceipt.hidden = !result.rewards;
                    rewardReceipt.textContent = result.rewards ? `Rewards discount: $${result.discount}. Earned ${result.rewards.pointsEarned} points. Used ${result.rewards.pointsRedeemed} points. Balance: ${result.rewards.points}.` : '';
                    document.getElementById('receipt-items').innerHTML = receiptLines.map(line => `
                        <div class="receipt-line">
                            <div><strong>${escapeHtml(line.name)}</strong><small>${line.quantity} × ${money(linePrice(line))}${line.customizations.length ? ` · ${escapeHtml(line.customizations.join(', '))}` : ''}</small></div>
                            <span>${money(linePrice(line) * line.quantity)}</span>
                        </div>`).join('');
                    const receipt = document.getElementById('receipt');
                    receipt.showModal();
                    document.getElementById('receipt-title').focus();
                }
                checkoutAttempt = null;
                cart.length = 0;
                window.dispatchEvent(new Event('order-completed'));
                window.rewardsWidget.reset();
                paymentMethod.value = '';
                paymentMethod.removeAttribute('aria-invalid');
                paymentMethod.removeAttribute('aria-describedby');
                renderCart();
                const rewardsNotice = result.rewards ? ` Earned ${result.rewards.pointsEarned} points. Balance: ${result.rewards.points}.${result.rewards.notification === 'queued' ? ' Reward text queued.' : result.rewards.notification === 'failed' ? ' Points saved; reward text could not be sent.' : ''}` : '';
                showNotice(`Order #${result.orderId} submitted. Total: $${result.total}. Payment: ${result.paymentMethod}.${rewardsNotice}`);
            } catch (error) {
                showNotice(checkoutAttempt ? 'The order status is uncertain. Tap Retry order to check the same order before making changes.' : error.message);
            } finally {
                placingOrder = false;
                document.querySelector('main').inert = false;
                document.querySelectorAll('main button:not(#submit), main input, main select, main details').forEach(control => control.inert = Boolean(checkoutAttempt));
                submitButton.textContent = checkoutAttempt ? 'Retry order' : <%- JSON.stringify(pageTitle === 'Cashier' ? 'Submit order' : 'Place order') %>;
                submitButton.disabled = cart.length === 0;
            }
        });

        document.getElementById('print-receipt')?.addEventListener('click', () => window.print());
        document.getElementById('new-order')?.addEventListener('click', () => {
            document.getElementById('receipt').close();
            document.querySelector('.drink')?.focus();
        });

        renderCart();
    </script>
</body>
</html>
