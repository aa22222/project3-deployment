<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Boba Shop POS — <%= pageTitle %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="<%= pageTitle === 'Cashier' ? 'cashier-page' : '' %>">
    <header>
        <div><h1><%= pageTitle === 'Customer Kiosk' ? 'Boba Shop' : 'Boba Shop POS' %></h1><p class="subtitle"><%= pageTitle === 'Customer Kiosk' ? 'Choose your drinks and customize your order' : 'Select a drink to customize it and add it to the order' %></p></div>
    </header>
    <main>
        <section class="panel menu-panel" aria-labelledby="menu-heading">
            <h2 id="menu-heading">Menu</h2>
            <% if (pageTitle === 'Cashier') { %>
            <label class="menu-search" for="menu-search">Find a menu item
                <input id="menu-search" type="search" placeholder="Search by name…" autocomplete="off" aria-controls="menu">
            </label>
            <p id="menu-results" role="status"><%= menuItems.length %> items available</p>
            <% } %>
            <div id="menu">
                <% menuItems.forEach(item => { %>
                    <button class="drink" type="button" data-id="<%= item.menu_item_id %>" data-name="<%= item.item_name %>" data-price="<%= item.current_price %>">
                        <span class="drink-name"><%= item.item_name %></span>
                        <span class="price">$<%= Number(item.current_price).toFixed(2) %></span>
                    </button>
                <% }); %>
                <% if (menuItems.length === 0) { %><p>No menu drinks are available yet.</p><% } %>
            </div>
        </section>
        <aside class="panel" aria-labelledby="order-heading">
            <h2 id="order-heading" class="cart-title">Order <% if (pageTitle === 'Cashier') { %><span id="order-count">0 items</span><% } else { %><span class="cart-hint">— tap × to remove</span><% } %></h2>
            <div id="cart" aria-live="polite"></div>
            <% if (pageTitle === 'Customer Kiosk') { %>
            <div class="customizations" aria-label="Order customizations">
                <button type="button" data-customization="Boba">Add boba (+$0.99)</button>
                <button type="button" data-customization="Less ice">Less ice</button>
                <button type="button" data-customization="More ice">More ice</button>
                <button type="button" data-customization="Less sweet">Less sweet</button>
            </div>
            <% } %>
            <div class="checkout">
                <div class="total"><span>TOTAL</span><span id="total">$0.00</span></div>
                <button id="submit" type="button"><%= pageTitle === 'Customer Kiosk' ? 'Place order' : 'Submit order' %></button>
                <p id="notice" role="status"></p>
            </div>
        </aside>
    </main>
    <% if (pageTitle === 'Cashier') { %>
    <dialog id="drink-editor" aria-labelledby="editor-title" aria-describedby="editor-hint">
        <form id="drink-form">
            <h2 id="editor-title">Customize drink</h2>
            <p id="editor-hint">Choose options for this order line. To order different options, add the drink again.</p>
            <label class="quantity-label" for="drink-quantity">Quantity</label>
            <input id="drink-quantity" name="quantity" type="number" min="1" max="1000" step="1" value="1" required autofocus>
            <fieldset>
                <legend>Toppings</legend>
                <label class="drink-option"><input id="drink-boba" name="boba" type="checkbox"> Add boba (+$0.99 per drink)</label>
            </fieldset>
            <fieldset>
                <legend>Ice level</legend>
                <label class="drink-option"><input type="radio" name="ice" value="" checked> Regular ice</label>
                <label class="drink-option"><input type="radio" name="ice" value="Less ice"> Less ice</label>
                <label class="drink-option"><input type="radio" name="ice" value="More ice"> More ice</label>
            </fieldset>
            <fieldset>
                <legend>Sweetness</legend>
                <label class="drink-option"><input type="radio" name="sweetness" value="" checked> Regular sweetness</label>
                <label class="drink-option"><input type="radio" name="sweetness" value="Less sweet"> Less sweet</label>
            </fieldset>
            <p class="editor-total">Item total <output id="item-total" data-testid="item-total" aria-live="polite">$0.00</output></p>
            <p id="editor-error" role="alert"></p>
            <div class="editor-actions">
                <button id="save-drink" type="submit">Add to order</button>
                <button id="cancel-drink" type="button">Cancel</button>
            </div>
        </form>
    </dialog>
    <% } %>
    <script>
        const cart = [];
        const money = value => '$' + value.toFixed(2);
        const escapeHtml = value => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
        const linePrice = line => line.price + (line.customizations.includes('Boba') ? 0.99 : 0);
        const sameCustomizations = (a, b) => a.length === b.length && a.every(value => b.includes(value));
        document.getElementById('menu-search')?.addEventListener('input', event => {
            const search = event.target.value.trim().toLowerCase();
            const buttons = [...document.querySelectorAll('.drink')];
            buttons.forEach(button => button.hidden = !button.dataset.name.toLowerCase().includes(search));
            const count = buttons.filter(button => !button.hidden).length;
            document.getElementById('menu-results').textContent = count ? `${count} items available` : 'No matching items. Try another name.';
        });

        const editor = document.getElementById('drink-editor');
        const form = document.getElementById('drink-form');
        let selectedDrink, editingIndex, editorTrigger;

        function openEditor(drink, index, trigger) {
            selectedDrink = drink;
            editingIndex = index;
            editorTrigger = trigger;
            form.reset();
            form.elements.quantity.value = drink.quantity;
            form.elements.boba.checked = drink.customizations.includes('Boba');
            form.elements.ice.value = drink.customizations.find(value => value.endsWith('ice')) || '';
            form.elements.sweetness.value = drink.customizations.includes('Less sweet') ? 'Less sweet' : '';
            document.getElementById('editor-title').textContent = `Customize ${drink.name}`;
            document.getElementById('save-drink').textContent = index === null ? 'Add to order' : 'Save changes';
            document.getElementById('editor-error').textContent = '';
            updateItemTotal();
            editor.showModal();
        }

        function editorChoices() {
            return [form.elements.boba.checked ? 'Boba' : '', form.elements.ice.value, form.elements.sweetness.value].filter(Boolean);
        }

        function updateItemTotal() {
            document.getElementById('item-total').textContent = form.elements.quantity.validity.valid
                ? money(linePrice({...selectedDrink, customizations: editorChoices()}) * Number(form.elements.quantity.value))
                : 'Enter a quantity from 1 to 1000';
        }

        if (editor) {
            form.addEventListener('input', updateItemTotal);
            document.getElementById('cancel-drink').onclick = () => editor.close();
            editor.addEventListener('keydown', event => {
                const first = form.elements.quantity, last = document.getElementById('cancel-drink');
                if (event.key === 'Tab' && (event.shiftKey ? document.activeElement === first : document.activeElement === last)) {
                    event.preventDefault();
                    (event.shiftKey ? last : first).focus();
                }
            });
            editor.addEventListener('close', () => {
                (editorTrigger.isConnected ? editorTrigger : document.querySelector(`[data-action="edit"][data-index="${editingIndex}"]`))?.focus();
            });
            form.addEventListener('submit', event => {
                event.preventDefault();
                const line = {...selectedDrink, quantity: Number(form.elements.quantity.value), customizations: editorChoices()};
                const match = cart.find(item => item !== cart[editingIndex] && item.menuItemId === line.menuItemId && sameCustomizations(item.customizations, line.customizations));
                if (match && match.quantity + line.quantity > 1000) {
                    document.getElementById('editor-error').textContent = 'Matching drinks cannot exceed 1000 per order line.';
                    return;
                }
                if (editingIndex !== null) cart.splice(editingIndex, 1);
                if (match) match.quantity += line.quantity;
                else cart.push(line);
                if (editingIndex !== null) editingIndex = cart.indexOf(match || line);
                renderCart();
                showNotice('');
                editor.close();
            });
        }

        document.querySelectorAll('.drink').forEach(button => button.addEventListener('click', () => {
            const id = Number(button.dataset.id);
            if (editor) return openEditor({menuItemId: id, name: button.dataset.name, price: Number(button.dataset.price), quantity: 1, customizations: []}, null, button);
            const line = cart.find(item => item.menuItemId === id && item.customizations.length === 0);
            if (line) line.quantity++;
            else cart.push({menuItemId: id, name: button.dataset.name, price: Number(button.dataset.price), quantity: 1, customizations: []});
            renderCart();
        }));

        function renderCart() {
            const cartElement = document.getElementById('cart');
            if (cart.length === 0) cartElement.innerHTML = '<p class="empty">Your order is empty.<br>Choose a drink to get started.</p>';
            else cartElement.innerHTML = cart.map((line, index) => `
                <div class="cart-line">
                    <div>
                        <div class="line-name">${escapeHtml(line.name)}</div>
                        <div class="line-meta">${line.quantity} × ${money(linePrice(line))} &nbsp; ${money(linePrice(line) * line.quantity)}</div>
                        ${line.customizations.length ? `<div class="line-custom">${escapeHtml(line.customizations.join(', '))}</div>` : ''}
                        <div class="line-actions">
                            <button class="qty-btn" type="button" data-action="decrease" data-index="${index}" aria-label="Remove one">−</button>
                            <span>${line.quantity}</span>
                            <button class="qty-btn" type="button" data-action="increase" data-index="${index}" aria-label="Add one">+</button>
                            ${editor ? `<button class="edit-drink" type="button" data-action="edit" data-index="${index}" aria-label="Edit ${escapeHtml(line.name)}">Edit</button>` : ''}
                        </div>
                    </div>
                    <button class="remove" type="button" data-action="remove" data-index="${index}" aria-label="Remove ${escapeHtml(line.name)}">×</button>
                </div>`).join('');
            const total = cart.reduce((sum, line) => sum + linePrice(line) * line.quantity, 0);
            document.getElementById('total').textContent = money(total);
            const orderCount = document.getElementById('order-count');
            if (orderCount) {
                const count = cart.reduce((sum, line) => sum + line.quantity, 0);
                orderCount.textContent = `${count} item${count === 1 ? '' : 's'}`;
            }
            document.getElementById('submit').disabled = cart.length === 0;
        }

        document.getElementById('cart').addEventListener('click', event => {
            const button = event.target.closest('[data-action]');
            if (!button) return;
            const index = Number(button.dataset.index);
            if (button.dataset.action === 'edit') return openEditor(cart[index], index, button);
            if (button.dataset.action === 'remove') cart.splice(index, 1);
            if (button.dataset.action === 'increase') {
                if (cart[index].quantity >= 1000) return showNotice('A drink quantity cannot exceed 1000 per order line.');
                cart[index].quantity++;
            }
            if (button.dataset.action === 'decrease') {
                cart[index].quantity--;
                if (cart[index].quantity === 0) cart.splice(index, 1);
            }
            renderCart();
        });

        document.querySelectorAll('[data-customization]').forEach(button => button.addEventListener('click', () => {
            const customization = button.dataset.customization;
            if (cart.length === 0) return showNotice('Add a drink to the order first.');
            const choices = cart.map((line, index) => `${index + 1}. ${line.name}${line.customizations.length ? ' — ' + line.customizations.join(', ') : ''} (${line.quantity})`);
            const choice = window.prompt(`Which drink should get ${customization.toLowerCase()}? Enter 1–${cart.length}.\n\n${choices.join('\n')}`);
            if (choice === null) return;
            const index = Number(choice) - 1;
            if (!Number.isInteger(index) || index < 0 || index >= cart.length) return showNotice('Choose a valid drink number.');
            const line = cart[index];
            if (line.customizations.includes(customization)) return showNotice(`${line.name} already has ${customization.toLowerCase()}.`);
            let quantity = 1;
            if (line.quantity > 1) {
                const input = window.prompt(`How many ${line.name} drinks should get ${customization.toLowerCase()}? Enter 1–${line.quantity}.`, '1');
                if (input === null) return;
                quantity = Number(input);
                if (!Number.isInteger(quantity) || quantity < 1 || quantity > line.quantity) return showNotice(`Enter a whole number from 1 to ${line.quantity}.`);
            }
            line.quantity -= quantity;
            if (line.quantity === 0) cart.splice(index, 1);
            const existing = cart.find(candidate => candidate.menuItemId === line.menuItemId && sameCustomizations(candidate.customizations, [...line.customizations, customization]));
            if (existing) existing.quantity += quantity;
            else cart.push({...line, quantity, customizations: [...line.customizations, customization]});
            showNotice('');
            renderCart();
        }));

        function showNotice(message) { document.getElementById('notice').textContent = message; }

        document.getElementById('submit').addEventListener('click', async () => {
            if (cart.length === 0) return showNotice('Tap a drink to add it to the order.');
            const submitButton = document.getElementById('submit');
            submitButton.disabled = true;
            showNotice('Submitting order…');
            try {
                const response = await fetch('/orders', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({items: cart.map(({menuItemId, quantity, customizations}) => ({menuItemId, quantity, customizations}))})
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || 'Could not submit the order.');
                cart.length = 0;
                renderCart();
                showNotice(`Order #${result.orderId} submitted. Total: $${result.total}`);
            } catch (error) {
                showNotice(error.message);
            } finally {
                submitButton.disabled = cart.length === 0;
            }
        });

        renderCart();
    </script>
</body>
</html>
