<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Boba Shop POS - Manager</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div>
            <h1>Boba Shop POS</h1>
            <p class="subtitle">Manager</p>
        </div>
        <a class="manager-back-link" href="/">Back to Portal Hub</a>
    </header>
    <main class="manager-main">
        <nav class="manager-tabs" aria-label="Manager sections">
            <a class="manager-tab" href="/manager" aria-current="page">Inventory</a>
            <a class="manager-tab" href="/manager/payroll">Payroll</a>
        </nav>
        <section class="manager-overview" aria-label="Inventory overview">
            <div class="manager-overview-copy">
                <h2>Inventory</h2>
                <p>Update stock quantities and see which items are at their reorder point.</p>
            </div>
            <p class="inventory-summary"><strong><%= inventory.length %></strong> items tracked <span aria-hidden="true">&middot;</span> <strong id="low-stock-count"><%= inventory.filter(item => Number(item.quantity_in_stock) <= Number(item.reorder_level || 0)).length %></strong> at reorder point</p>
        </section>
        <section class="panel manager-panel">
            <% if (useMockDatabase) { %><p class="manager-demo-note">Demo inventory - changes reset when the server restarts.</p><% } %>
            <form action="/manager" class="inventory-toolbar">
                <label class="menu-search" for="inventory-search">Find an inventory item
                    <input id="inventory-search" type="search" placeholder="Search by name..." autocomplete="off" aria-controls="inventory-list">
                </label>
                <button type="submit">Refresh inventory</button>
            </form>
            <p id="inventory-message" role="status"><%= error || (inventory.length ? '' : 'No inventory items found.') %></p>
            <div id="inventory-list">
                <% inventory.forEach(item => {
                    const quantity = Number(item.quantity_in_stock);
                    const reorderLevel = Number(item.reorder_level || 0);
                    const isLow = quantity <= reorderLevel;
                    const statusText = quantity <= 0 ? 'Out of stock' : (isLow ? 'At reorder point' : 'In stock');
                %>
                <form class="inventory-row" data-id="<%= item.inventory_item_id %>" data-reorder-level="<%= reorderLevel %>">
                    <div class="inventory-item-info">
                        <label for="stock-<%= item.inventory_item_id %>"><%= item.item_name %></label>
                        <span class="inventory-item-meta"><%= item.item_type || 'Inventory item' %></span>
                    </div>
                    <div class="inventory-stock-control">
                        <input id="stock-<%= item.inventory_item_id %>" aria-label="<%= item.item_name %> stock quantity" type="number" min="0" max="9999999999.99" step="0.01" value="<%= item.quantity_in_stock %>" required>
                        <span><%= item.unit || 'units' %></span>
                    </div>
                    <span class="inventory-status" data-stock-status><%= statusText %></span>
                    <button type="submit">Save</button>
                    <span role="status" class="inventory-feedback"></span>
                </form>
                <% }); %>
            </div>
        </section>
    </main>
    <script>
        const rows = [...document.querySelectorAll('.inventory-row')];
        const lowStockCount = document.getElementById('low-stock-count');
        const updateLowStockCount = () => {
            lowStockCount.textContent = rows.filter(row => Number(row.querySelector('input').value) <= Number(row.dataset.reorderLevel)).length;
        };
        document.getElementById('inventory-search').addEventListener('input', event => {
            const search = event.target.value.trim().toLowerCase();
            rows.forEach(row => row.hidden = !row.querySelector('label').textContent.toLowerCase().includes(search));
            if (rows.length) document.getElementById('inventory-message').textContent = rows.some(row => !row.hidden) ? '' : 'No matching inventory items.';
        });
        rows.forEach(row => row.addEventListener('submit', async event => {
            event.preventDefault();
            const button = row.querySelector('button'), input = row.querySelector('input'), feedback = row.querySelector('.inventory-feedback');
            button.disabled = true;
            input.disabled = true;
            feedback.textContent = 'Saving...';
            try {
                const response = await fetch(`/api/inventory/${row.dataset.id}`, {
                    method: 'PATCH', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ quantity: Number(input.value) })
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.error || 'Could not save inventory.');
                input.value = result.quantity_in_stock;
                const quantity = Number(input.value), isLow = quantity <= Number(row.dataset.reorderLevel);
                row.querySelector('[data-stock-status]').textContent = quantity <= 0 ? 'Out of stock' : (isLow ? 'At reorder point' : 'In stock');
                updateLowStockCount();
                feedback.textContent = 'Saved';
            } catch (error) {
                feedback.textContent = error.message;
            } finally {
                button.disabled = false;
                input.disabled = false;
            }
        }));
    </script>
</body>
</html>
