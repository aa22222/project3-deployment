<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Boba Shop POS — Portal</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="portal-page">
    <header>
        <div>
            <h1>Boba Shop POS</h1>
            <p class="subtitle">Choose an area to get started</p>
        </div>
    </header>
    <main class="portal-main">
        <nav class="portal-grid" aria-label="Shop areas">
            <a class="portal-card" href="/cashier">
                <span class="portal-card-title">Cashier</span>
                <span class="portal-card-description">Create customer orders and process payments.</span>
            </a>
            <a class="portal-card" href="/manager">
                <span class="portal-card-title">Manager</span>
                <span class="portal-card-description">Manage products, inventory, and store operations.</span>
            </a>
            <a class="portal-card" href="/kitchen">
                <span class="portal-card-title">Kitchen</span>
                <span class="portal-card-description">View incoming orders and prepare drinks.</span>
            </a>
            <a class="portal-card" href="/kiosk">
                <span class="portal-card-title">Customer Kiosk</span>
                <span class="portal-card-description">Let customers browse the menu and place orders.</span>
            </a>
        </nav>
    </main>
</body>
</html>
