PSQL_USER=your_database_username
PSQL_HOST=your_database_host
PSQL_DATABASE=your_database_name
PSQL_PASSWORD=your_database_password
PSQL_PORT=5432

# Reward texts and phone sign-in (Twilio SMS-capable sender)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email sign-in (Resend API key and a verified sender)
RESEND_API_KEY=
REWARDS_EMAIL_FROM=

# Menu assistant: use a Groq account kept on the Free plan, with no billing.
GROQ_API_KEY=
